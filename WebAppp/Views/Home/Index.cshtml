@{
    ViewData["Title"] = "Home";
}

<div class="container mt-5">

    <div class="text-center py-5 bg-light rounded shadow-sm">
        <h1 class="display-3 fw-bold text-primary">
            Welcome to WebAppp
        </h1>

        <p class="lead mt-3">
            Build modern web applications using ASP.NET Core MVC.
        </p>

        <div class="mt-4">
            <a asp-controller="Product"
               asp-action="Index"
               class="btn btn-primary btn-lg me-2">
                View Products
            </a>

            <a asp-controller="Category"
               asp-action="Index"
               class="btn btn-success btn-lg">
                View Categories
            </a>
        </div>
    </div>

    <div class="row mt-5">

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>Products</h3>
                    <p>
                        Manage products, prices, and descriptions using MVC.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>Categories</h3>
                    <p>
                        Organize products into categories with validation.
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow h-100">
                <div class="card-body text-center">
                    <h3>Contact</h3>
                    <p>
                        Get in touch with us through our contact form.
                    </p>
                </div>
            </div>
        </div>

    </div>

</div>